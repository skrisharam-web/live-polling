# Backend configuration. Copy to backend/.env and fill in for local development.
# Every value is read once, at startup, by internal/config.

APP_ENV=development
PORT=8080

# MongoDB — durable source of truth
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=livepolling

# Redis — live counters, realtime Pub/Sub, rate limiting
REDIS_URL=redis://localhost:6379/0

# Auth. Generate a real secret with: openssl rand -base64 48
# Required in production and must be at least 32 characters there.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Comma-separated list of allowed browser origins. Never "*": the API uses
# credentialed cookies.
FRONTEND_URL=http://localhost:5173

# Must be true in production (HTTPS only).
COOKIE_SECURE=false
# Leave empty unless the API and frontend share a parent domain.
COOKIE_DOMAIN=
