# Frontend configuration. Copy to frontend/.env for local development.
#
# Vite only exposes variables prefixed with VITE_, and it substitutes them at
# build time — so everything here ends up in readable JavaScript. Never put a
# secret in this file.
#
# Without these the app calls its own origin for /api, the dev server answers
# with index.html, and every request fails in a way that looks like a broken
# session rather than missing configuration.

VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
